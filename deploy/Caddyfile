# Caddy reverse proxy -> TLS for the Srelok Go daemon.
#
# Caddy automatically provisions a Let's Encrypt certificate, so no separate
# certbot/nginx config is needed. You MUST point a real domain's DNS A record
# at your VPS IP and replace the placeholder hostname below.
#
# Install:  apt install -y caddy   (or the official static binary)
# Run:      caddy run --config /etc/caddy/Caddyfile
#
# The daemon listens on 127.0.0.1:3201 (or :3201); Caddy fronts it over HTTPS.

srelok.example.com {
	reverse_proxy 127.0.0.1:3201

	encode gzip

	@ops {
		path /api/* /ws
	}
	# Allow the Astro frontend (Netlify) to reach the API cross-origin.
	handle @ops {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization"
		reverse_proxy 127.0.0.1:3201
	}

	header {
		-Server
	}
}