# Unused on the live VPS (Coolify Traefik owns 80/443). Kept as a single-host
# alternate. Live listen is daemon :3200 behind nginx :38471 — see deploy/README.md.

srelok.example.com {
	reverse_proxy 127.0.0.1:3201

	encode gzip

	@ops {
		path /api/* /ws
	}
	# Allow the Astro frontend (Netlify) to reach the API cross-origin.
	handle @ops {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization"
		reverse_proxy 127.0.0.1:3201
	}

	header {
		-Server
	}
}