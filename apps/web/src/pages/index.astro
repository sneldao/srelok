---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Pipeline from "../components/Pipeline.astro";
import LiveFeed from "../components/LiveFeed.astro";
import ChainMap from "../components/ChainMap.astro";
import Rewards from "../components/Rewards.astro";
import Controls from "../components/Controls.astro";
---

<Base title="Srelok — The On-Chain Detective">
  <Hero />
  <Pipeline />
  <ChainMap />
  <LiveFeed />
  <Rewards />
  <Controls />

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container site-footer__inner">
      <span class="mono">srelok v0.1.0 — built with kiro</span>
      <a href="https://github.com/sneldao/srelok" target="_blank" rel="noopener" class="mono">
        github ↗
      </a>
    </div>
  </footer>

  <!-- Scene initialization -->
  <script>
    import { createChainScene } from "../lib/three/chain-particles";
    import { initReveals } from "../lib/gsap/reveals";

    // Initialize Three.js particle scene
    const canvas = document.getElementById("scene-canvas") as HTMLCanvasElement;
    if (canvas) {
      createChainScene(canvas);
    }

    // Initialize GSAP reveal animations
    initReveals();
  </script>
</Base>
