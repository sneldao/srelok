---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Pipeline from "../components/Pipeline.astro";
import LiveFeed from "../components/LiveFeed.astro";
---

<Base title="Srelok — The On-Chain Detective">
  <Hero />
  <Pipeline />
  <LiveFeed />

  <!-- Scene initialization -->
  <script>
    import { createChainScene } from "../lib/three/chain-particles";
    import { initReveals } from "../lib/gsap/reveals";

    // Initialize Three.js particle scene
    const canvas = document.getElementById("scene-canvas") as HTMLCanvasElement;
    if (canvas) {
      createChainScene(canvas);
    }

    // Initialize GSAP reveal animations
    document.addEventListener("DOMContentLoaded", () => {
      // Small delay to let fonts load
      setTimeout(() => {
        initReveals();
      }, 100);
    });

    // Also trigger on page load (for Astro)
    initReveals();
  </script>
</Base>
