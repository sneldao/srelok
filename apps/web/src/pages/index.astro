---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Pipeline from "../components/Pipeline.astro";
import LiveFeed from "../components/LiveFeed.astro";
import ChainMap from "../components/ChainMap.astro";
import Rewards from "../components/Rewards.astro";
import Controls from "../components/Controls.astro";
---

<Base title="Srelok — The On-Chain Detective">
  <Hero />
  <Pipeline />
  <ChainMap />
  <LiveFeed />
  <Rewards />
  <Controls />

  <!-- Footer -->
  <footer class="section" style="padding: 2rem 0; border-top: 1px solid var(--color-border);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <span class="mono" style="font-size: 0.75rem; color: var(--color-text-muted);">
        srelok v0.1.0 — built with kiro
      </span>
      <a href="https://github.com/sneldao/srelok" target="_blank" rel="noopener" class="mono" style="font-size: 0.75rem; color: var(--color-text-muted); text-decoration: none;">
        github ↗
      </a>
    </div>
  </footer>

  <!-- Scene initialization -->
  <script>
    import { createChainScene } from "../lib/three/chain-particles";
    import { initReveals } from "../lib/gsap/reveals";

    // Initialize Three.js particle scene
    const canvas = document.getElementById("scene-canvas") as HTMLCanvasElement;
    if (canvas) {
      createChainScene(canvas);
    }

    // Initialize GSAP reveal animations
    initReveals();
  </script>
</Base>
