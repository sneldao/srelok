---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { loadDossier } from "../lib/dossier";

const { stats, submissions } = await loadDossier();
---

<Base
  title="Srelok — Names for the untagged"
  description="Autonomous curator for Kleros Scout: names for untagged contracts, policy-clean items, PNK if they stand."
>
  <Hero stats={stats} exhibit={submissions[0]} />
</Base>
