---
import Base from "../layouts/Base.astro";
---

<Base
  title="Missing leaf — Srelok"
  description="This page is not in the docket."
>
  <article class="docket">
    <p class="mono docket__kicker">404</p>
    <h1>Not in the file.</h1>
    <p class="section-lede">
      That path is not a folio leaf. The case is Brief, Gates, Evidence, Field, and Hand.
    </p>
    <p class="docket__stop mono"><a href="/">return to the brief</a></p>
  </article>
</Base>

<style>
  .docket {
    padding: 7.25rem clamp(1.25rem, 4vw, 3.5rem) 4rem;
    max-width: 36rem;
  }

  .docket__kicker {
    margin: 0 0 1rem;
    color: var(--color-error);
  }

  .docket h1 {
    margin: 0;
  }

  .docket__stop {
    margin: 2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-text);
  }

  .docket__stop a {
    color: var(--color-accent);
  }
</style>
