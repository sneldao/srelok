---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Srelok", description = "The on-chain detective — autonomous AI curation for the decentralized web" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Three.js canvas (behind everything) -->
    <canvas id="scene-canvas"></canvas>

    <!-- Main content -->
    <div class="content">
      <slot />
    </div>

    <!-- Global scripts -->
    <script>
      import "../lib/gsap/init.ts";
      import "../lib/smooth-scroll.ts";
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
