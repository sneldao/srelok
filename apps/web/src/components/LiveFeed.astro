---
/**
 * Live ticker — SSE still drives it; no section essay.
 */
---

<section class="feed" id="feed">
  <div class="feed__bar">
    <span class="mono feed__live">
      <span class="status-dot status-dot--accepted"></span>
      live
    </span>
    <div class="feed__list" id="feed-list">
      <span class="feed__empty mono">awaiting signal</span>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { prefersReducedMotion } from "../lib/gsap/init";

  const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";
  const feedList = document.getElementById("feed-list");

  function createFeedEntry(data: {
    type: string;
    chain?: string;
    address?: string;
    name?: string;
    timestamp: string;
  }) {
    const el = document.createElement("div");
    el.className = "feed__entry";

    const chain = data.chain || "gnosis";
    const addr = data.address ? `${data.address.slice(0, 6)}…${data.address.slice(-4)}` : "";
    const labels: Record<string, string> = {
      candidate_found: "found",
      submission_complete: "submitted",
      discovery_started: "scan",
    };
    const label = labels[data.type] || data.type.replace(/_/g, " ");

    el.innerHTML = `
      <span class="chain-badge chain-badge--${chain}">${chain}</span>
      <span>${label}</span>
      ${addr ? `<span class="mono">${addr}</span>` : ""}
      ${data.name ? `<span>${data.name}</span>` : ""}
    `;

    feedList?.querySelector(".feed__empty")?.remove();
    feedList?.prepend(el);

    if (!prefersReducedMotion()) {
      gsap.fromTo(el, { autoAlpha: 0, x: 12 }, { autoAlpha: 1, x: 0, duration: 0.2, ease: "power2.out" });
    }

    const entries = feedList?.querySelectorAll(".feed__entry");
    if (entries && entries.length > 8) entries[entries.length - 1].remove();
  }

  function connectFeed() {
    const evtSource = new EventSource(`${API_BASE}/api/feed`);
    evtSource.onmessage = (event) => {
      try {
        createFeedEntry(JSON.parse(event.data));
      } catch {
        /* ignore */
      }
    };
    evtSource.onerror = () => {
      evtSource.close();
      setTimeout(connectFeed, 5000);
    };
  }

  if (typeof window !== "undefined") connectFeed();
</script>

<style>
  .feed {
    padding: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .feed__bar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1rem clamp(1.25rem, 4vw, 3.5rem);
  }

  .feed__live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text);
  }

  .feed__list {
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    align-items: center;
    min-height: 2rem;
  }

  .feed__empty {
    color: var(--color-text-muted);
  }

  .feed__entry {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
</style>
