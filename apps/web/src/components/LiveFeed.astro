---
---

<section class="feed section" id="feed">
  <div class="container">
    <p class="mono section-kicker">
      <span class="status-dot status-dot--accepted"></span>
      live
    </p>
    <h2>Activity</h2>
    <p class="section-lede">
      Discoveries, evaluations, and on-chain submits stream from the daemon as they happen. This is the agent’s log, not a marketing ticker.
    </p>

    <div class="feed__list" id="feed-list">
      <p class="feed__empty mono">No events yet — the next discovery cycle will land here.</p>
    </div>
  </div>
</section>

<style>
  .feed__list {
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .feed__empty {
    padding: 1.25rem 0;
    color: var(--color-text-muted);
    text-transform: none;
    letter-spacing: 0;
  }

  .feed__list :global(.feed__entry) {
    display: grid;
    grid-template-columns: 6.5rem 7rem 1fr;
    gap: 0.75rem 1rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .feed__list :global(.feed__time) {
    color: var(--color-text-muted);
  }

  .feed__list :global(.feed__meta) {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .feed__list :global(.feed__entry) {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
