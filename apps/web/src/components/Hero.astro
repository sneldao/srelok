---
/**
 * Opening case file: name, one line, six steps, live rim.
 * Type sits on paper. Emphasis is CSS, not a canvas mask.
 */
const verbs = [
  { id: "discover", label: "Discover" },
  { id: "research", label: "Research" },
  { id: "evaluate", label: "Evaluate" },
  { id: "build", label: "Build" },
  { id: "submit", label: "Submit" },
  { id: "track", label: "Track" },
];
---

<section class="hero" id="hero">
  <div class="hero__copy">
    <p class="mono hero__kicker">
      <span class="status-dot status-dot--accepted"></span>
      gnosis · scout
    </p>
    <h1>Srelok</h1>
    <p class="hero__lede">Autonomous curation for Kleros Scout registries.</p>
  </div>

  <ol class="hero__steps">
    {verbs.map((v, i) => (
      <li class="hero__step" data-verb={v.id} style={`--i: ${i}`}>
        <span class="mono hero__idx">{String(i + 1).padStart(2, "0")}</span>
        <span class="hero__label">{v.label}</span>
      </li>
    ))}
  </ol>

  <div class="hero__hud">
    <span class="mono" id="hud-feed">awaiting</span>
    <span class="mono tabular" id="hud-pnk">0 PNK</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto auto;
    padding: 6.5rem clamp(1.25rem, 4vw, 3.5rem) 1.75rem;
    gap: 2.5rem;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    color: var(--color-text);
  }

  .hero h1 {
    margin: 0;
    color: var(--color-text);
  }

  .hero__lede {
    margin: 1rem 0 0;
    max-width: 22rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .hero__steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem 2rem;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-border);
    max-width: 36rem;
  }

  .hero__step {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    gap: 0.65rem;
    margin: 0;
    padding: 0.45rem 0;
    color: var(--color-text);
    opacity: 0.3;
    animation: step-on 18s calc(var(--i) * -3s) infinite;
  }

  .hero__idx {
    color: var(--color-accent);
  }

  .hero__label {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero.is-live .hero__step {
    animation: none;
    opacity: 0.3;
  }

  .hero.is-live .hero__step.is-on {
    opacity: 1;
  }

  .hero__hud {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
  }

  #hud-feed.is-flash {
    animation: flash 0.55s var(--ease-out);
  }

  @keyframes step-on {
    0%,
    12% {
      opacity: 1;
    }
    16.6%,
    100% {
      opacity: 0.3;
    }
  }

  @keyframes flash {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr minmax(16rem, 22rem);
      grid-template-rows: 1fr auto;
      align-items: end;
      column-gap: 3rem;
    }

    .hero__copy {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }

    .hero__steps {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      grid-template-columns: 1fr;
      max-width: none;
      border-top: 0;
      padding-top: 0;
    }

    .hero__hud {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__step {
      animation: none;
      opacity: 1;
    }
  }
</style>
