---
/**
 * The instrument: paper, aperture, verbs inside the hole, HUD on the rim.
 */
const verbs = [
  { id: "discover", label: "Discover" },
  { id: "research", label: "Research" },
  { id: "evaluate", label: "Evaluate" },
  { id: "build", label: "Build" },
  { id: "submit", label: "Submit" },
  { id: "track", label: "Track" },
];
---

<section class="hero" id="hero" style="--progress: 0">
  <div class="hero__paper" aria-hidden="true"></div>

  <div class="hero__verbs" aria-hidden="true">
    {verbs.map((v) => (
      <p class="hero__verb" data-verb={v.id}>{v.label}</p>
    ))}
  </div>

  <div class="hero__copy">
    <h1>Srelok</h1>
  </div>

  <div class="hero__hud">
    <span class="mono" id="hud-feed">awaiting</span>
    <span class="mono tabular" id="hud-pnk">0 PNK</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    --r: calc(16vmin + (var(--progress) * 120vmin));
  }

  .hero__paper {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    -webkit-mask-image: radial-gradient(
      circle at 50% 46%,
      transparent var(--r),
      #000 calc(var(--r) + 1.5px)
    );
    mask-image: radial-gradient(
      circle at 50% 46%,
      transparent var(--r),
      #000 calc(var(--r) + 1.5px)
    );
    pointer-events: none;
  }

  .hero__verbs {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    pointer-events: none;
    clip-path: circle(var(--r) at 50% 46%);
  }

  .hero__verb {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 13rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.07em;
    color: #f1ead8;
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .hero__verb.is-on {
    opacity: 1;
    transform: scale(1);
  }

  .hero__copy {
    position: absolute;
    left: clamp(1.25rem, 4vw, 3.5rem);
    bottom: 8vh;
    z-index: 2;
    color: var(--color-text);
    pointer-events: none;
    opacity: calc(1 - var(--progress) * 1.4);
  }

  .hero h1 {
    margin: 0;
  }

  .hero__hud {
    position: absolute;
    left: clamp(1.25rem, 4vw, 3.5rem);
    right: clamp(1.25rem, 4vw, 3.5rem);
    bottom: 2.4rem;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-text);
    mix-blend-mode: difference;
    color: #f1ead8;
  }

  .hero.is-wide .hero__hud {
    mix-blend-mode: normal;
    color: #f1ead8;
  }
</style>
