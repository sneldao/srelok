---
import { getCollection } from "astro:content";
import { parties } from "../lib/folio";
import {
  atrColumns,
  formatWhen,
  gnosisAddress,
  gnosisTx,
  ipfsUrl,
  parsePayload,
  shortAddr,
  type AgentStats,
  type Submission,
} from "../lib/dossier";

interface Props {
  stats: AgentStats;
  exhibit?: Submission;
}

const { stats, exhibit } = Astro.props;
const steps = (await getCollection("gates")).sort((a, b) => a.data.order - b.data.order);

const named = stats.totalSubmissions > 0 ? String(stats.totalSubmissions) : "—";
const pnk = stats.totalPnkEarned && stats.totalPnkEarned !== "0" ? stats.totalPnkEarned : "—";
const payload = exhibit ? parsePayload(exhibit.payloadJson) : null;
const values =
  payload && typeof payload === "object" && payload.values && typeof payload.values === "object"
    ? (payload.values as Record<string, string>)
    : null;
---

<section class="hero" id="hero">
  <div class="hero__copy">
    <p class="mono hero__kicker">
      <span class="status-dot status-dot--accepted"></span>
      docket · gnosis · scout
    </p>
    <h1>Names for the untagged. PNK if they stand.</h1>
    <p class="hero__lede">
      Srelok is the detective on the
      <a href="https://docs.kleros.io/products/scout-earn">Kleros Scout</a>
      beat. It finds contracts explorers have not labelled, argues what they are against MetaEvidence, and only then calls <span class="mono hero__code">addItem</span> — so Scout stays clean, users can read a chain, and the operator is paid when the challenge window closes.
    </p>
  </div>

  <ol class="hero__docket">
    {parties.map((row, i) => (
      <li>
        <a href={row.href} data-astro-prefetch>
          <span class="mono hero__docket-idx" transition:name={`party-${row.id}`}>
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="mono hero__docket-who">{row.who}</span>
          <span class="hero__docket-out">{row.outcome}</span>
        </a>
      </li>
    ))}
  </ol>

  <dl class="hero__stats">
    <div>
      <dt class="mono">named this cycle</dt>
      <dd class="tabular" id="stat-submissions">{named}</dd>
    </div>
    <div>
      <dt class="mono">explorers watched</dt>
      <dd class="tabular">12</dd>
    </div>
    <div>
      <dt class="mono">Scout registries</dt>
      <dd class="tabular">4</dd>
    </div>
    <div>
      <dt class="mono">PNK to operator</dt>
      <dd class="tabular" id="hud-pnk-brief">{pnk}</dd>
    </div>
  </dl>

  <ol class="hero__steps">
    {steps.map((s) => (
      <li class="hero__step" data-verb={s.id}>
        <a href={`/gates/${s.id}`} data-astro-prefetch>
          <span class="mono hero__idx" transition:name={`docket-${s.id}`}>
            {String(s.data.order).padStart(2, "0")}
          </span>
          <span class="hero__label">{s.data.label}</span>
          <span class="hero__hint">{s.data.hint}</span>
        </a>
      </li>
    ))}
  </ol>

  <aside class="exhibit">
    {exhibit ? (
      <>
        <p class="mono exhibit__kicker">exhibit · latest on Gnosis</p>
        <p class="exhibit__tag">{exhibit.tag || shortAddr(exhibit.address) || "untitled item"}</p>
        <dl class="exhibit__meta">
          <div>
            <dt class="mono">address</dt>
            <dd>
              <a href={gnosisAddress(exhibit.address)} target="_blank" rel="noopener" class="mono">
                {shortAddr(exhibit.address)}
              </a>
            </dd>
          </div>
          <div>
            <dt class="mono">registry</dt>
            <dd class="mono">{exhibit.registry}</dd>
          </div>
          <div>
            <dt class="mono">status</dt>
            <dd class="mono">{exhibit.status}</dd>
          </div>
          <div>
            <dt class="mono">when</dt>
            <dd class="mono">{formatWhen(exhibit.submittedAt)}</dd>
          </div>
        </dl>
        <p class="exhibit__links mono">
          {exhibit.txHash && (
            <a href={gnosisTx(exhibit.txHash)} target="_blank" rel="noopener">tx</a>
          )}
          {exhibit.ipfsCid && (
            <a href={ipfsUrl(exhibit.ipfsCid)} target="_blank" rel="noopener">item.json</a>
          )}
          <a href="/evidence">full log</a>
        </p>
        <details class="exhibit__payload">
          <summary class="mono">item.json</summary>
          {values ? (
            <dl>
              {Object.entries(values).map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <pre>{exhibit.payloadJson || "payload not stored"}</pre>
          )}
        </details>
      </>
    ) : (
      <>
        <p class="mono exhibit__kicker">exhibit · ATR schema · no item on file yet</p>
        <p class="exhibit__tag">The form jurors read</p>
        <p class="exhibit__note">
          Until the daemon lands an addItem, this is the Address Tags shape — column for column with MetaEvidence. Empty on purpose.
        </p>
        <details class="exhibit__payload" open>
          <summary class="mono">item.json columns</summary>
          <ol>
            {atrColumns.map((col) => (
              <li>
                <span class="mono">{col}</span>
                <span class="exhibit__blank">—</span>
              </li>
            ))}
          </ol>
        </details>
      </>
    )}
  </aside>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.25rem;
    padding: 7.25rem clamp(1.25rem, 4vw, 3.5rem) 3rem;
  }

  .hero > * {
    animation: rise 0.7s var(--ease-out-expo) both;
  }

  .hero__docket { animation-delay: 0.06s; }
  .hero__stats { animation-delay: 0.12s; }
  .hero__steps { animation-delay: 0.18s; }
  .exhibit { animation-delay: 0.22s; }

  :global(html:active-view-transition) .hero > * {
    animation: none;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.1rem;
    color: var(--color-text);
  }

  .hero h1 {
    margin: 0;
    max-width: 16ch;
    color: var(--color-text);
  }

  .hero__lede {
    margin: 1.15rem 0 0;
    max-width: 40rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .hero__lede a {
    color: var(--color-text);
    text-underline-offset: 0.18em;
  }

  .hero__code {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.9em;
    color: var(--color-text);
  }

  .hero__docket {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-border);
    max-width: 40rem;
  }

  .hero__docket a {
    display: grid;
    grid-template-columns: 2.2rem 7.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .hero__docket-idx {
    color: var(--color-accent);
    display: inline-block;
  }

  .hero__docket-who {
    color: var(--color-text);
  }

  .hero__docket-out {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .hero__docket a:hover .hero__docket-who {
    color: var(--color-accent);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-border);
    max-width: 40rem;
  }

  .hero__stats dt {
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .hero__stats dd {
    margin: 0;
    min-width: 4ch;
    min-height: 1em;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
  }

  .hero__steps {
    list-style: none;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .hero__step a {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 8rem) 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .hero__idx {
    color: var(--color-accent);
    display: inline-block;
  }

  .hero__label {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .hero__hint {
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .hero__step.is-on .hero__label {
    color: var(--color-accent);
  }

  .exhibit {
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-border);
    max-width: 40rem;
  }

  .exhibit__kicker {
    margin: 0 0 0.45rem;
    color: var(--color-accent);
  }

  .exhibit__tag {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .exhibit__note {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }

  .exhibit__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 1.25rem;
    margin: 1rem 0 0;
  }

  .exhibit__meta dt {
    color: var(--color-text-muted);
  }

  .exhibit__meta dd {
    margin: 0.15rem 0 0;
    color: var(--color-text);
  }

  .exhibit__meta a {
    color: var(--color-text);
  }

  .exhibit__links {
    display: flex;
    gap: 1.25rem;
    margin: 0.9rem 0 0;
  }

  .exhibit__links a {
    color: var(--color-text);
  }

  .exhibit__payload {
    margin-top: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.55rem 0.75rem;
  }

  .exhibit__payload summary {
    cursor: pointer;
    color: var(--color-text-muted);
  }

  .exhibit__payload ol,
  .exhibit__payload dl {
    margin: 0.7rem 0 0.2rem;
    padding: 0;
    list-style: none;
  }

  .exhibit__payload li,
  .exhibit__payload dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.85rem;
  }

  .exhibit__blank {
    color: var(--color-text-muted);
  }

  .exhibit__payload pre {
    margin: 0.65rem 0 0.2rem;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.9fr);
      grid-template-rows: auto auto auto auto;
      column-gap: 3.5rem;
      row-gap: 1.75rem;
      padding-top: 8rem;
    }

    .hero__copy { grid-column: 1; grid-row: 1; }
    .hero__docket { grid-column: 1; grid-row: 2; max-width: none; }
    .hero__stats {
      grid-column: 1;
      grid-row: 3;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: none;
    }
    .hero__steps {
      grid-column: 2;
      grid-row: 1 / span 3;
      border-top: 0;
      align-self: start;
    }
    .exhibit {
      grid-column: 1 / -1;
      grid-row: 4;
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero__docket a {
      grid-template-columns: 2.2rem 1fr;
    }

    .hero__docket-out {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero > * {
      animation: none;
    }
  }
</style>
