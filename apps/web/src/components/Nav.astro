---
import { folio } from "../lib/folio";
---

<div class="nav-shell" transition:persist="nav">
  <header class="nav">
    <a class="nav__mark mono" href="/">srelok</a>
  </header>

  <nav class="folio-tabs" aria-label="Folio leaves">
    {folio.map((l) => (
      <a class="folio-tabs__leaf" href={l.href} data-astro-prefetch data-leaf={l.leaf}>
        <span class="folio-tabs__name">{l.tab}</span>
        <span class="folio-tabs__for">{l.for}</span>
      </a>
    ))}
  </nav>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { normalizePath, walk } from "../lib/folio";

  function markCurrent() {
    const path = normalizePath(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>(".folio-tabs__leaf").forEach((a) => {
      const href = a.getAttribute("href") || "";
      const active = href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
      if (active) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }

  let keysBound = false;

  function bindKeys() {
    if (keysBound) return;
    keysBound = true;

    document.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      if (t?.closest("input, textarea, select, dialog, [contenteditable]")) return;

      const path = normalizePath(location.pathname);
      const step = path.startsWith("/gates") ? "/gates" : path;
      const i = (walk as readonly string[]).indexOf(step);
      if (i < 0) return;

      if (e.key === "ArrowRight" || e.key === "j") {
        const next = walk[i + 1];
        if (next) {
          e.preventDefault();
          navigate(next);
        }
      }
      if (e.key === "ArrowLeft" || e.key === "k") {
        const prev = walk[i - 1];
        if (prev) {
          e.preventDefault();
          navigate(prev);
        }
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    bindKeys();
    markCurrent();
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    padding: 1rem clamp(1.25rem, 4vw, 3.5rem);
    pointer-events: none;
  }

  .nav__mark {
    pointer-events: auto;
    text-decoration: none;
    color: var(--color-text);
  }

  .folio-tabs {
    position: fixed;
    top: 3.35rem;
    left: 0;
    right: 0;
    z-index: 42;
    display: flex;
    justify-content: space-between;
    gap: 0.15rem;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
    pointer-events: none;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
  }

  .folio-tabs__leaf {
    pointer-events: auto;
    flex: 1;
    min-width: 0;
    text-align: center;
    text-decoration: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.55rem 0.2rem 0.5rem;
    border-bottom: 2px solid transparent;
  }

  .folio-tabs__name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .folio-tabs__for {
    display: none;
  }

  .folio-tabs__leaf:hover {
    color: var(--color-text);
  }

  .folio-tabs__leaf[aria-current="page"] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  @media (min-width: 960px) {
    .folio-tabs {
      top: 50%;
      right: 0;
      left: auto;
      transform: translateY(-50%);
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.28rem;
      padding: 0;
      border: 0;
      background: transparent;
      width: auto;
    }

    .folio-tabs__leaf {
      flex: none;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      text-align: start;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-right: 0;
      padding: 1.15rem 0.4rem;
      color: var(--color-text);
    }

    .folio-tabs__leaf[aria-current="page"] {
      background: var(--color-text);
      color: var(--color-bg);
      border-color: var(--color-text);
      padding-left: 0.65rem;
    }

    .folio-tabs__leaf[aria-current="page"] .folio-tabs__name {
      color: var(--color-bg);
    }
  }
</style>
