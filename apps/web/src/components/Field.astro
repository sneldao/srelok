---
const registries = [
  { key: "atr", label: "Address Tags", serves: "Explorers", pool: "100,000", max: "500 PNK", contract: "0x66260C69…" },
  { key: "tokens", label: "Token Registry", serves: "Wallets", pool: "100,000", max: "500 PNK", contract: "0xeE1502e2…" },
  { key: "cdn", label: "Contract Domains", serves: "Projects", pool: "100,000", max: "500 PNK", contract: "0x957A53A9…" },
  { key: "atq", label: "Address Tag Queries", serves: "Tooling", pool: "60,000", max: "pool share", contract: "0xAe6aaed5…" },
];

const chains = [
  { id: "ethereum", label: "Ethereum" },
  { id: "base", label: "Base" },
  { id: "arbitrum", label: "Arbitrum" },
  { id: "optimism", label: "Optimism" },
  { id: "gnosis", label: "Gnosis" },
  { id: "polygon", label: "Polygon" },
  { id: "linea", label: "Linea" },
  { id: "avalanche", label: "Avalanche" },
  { id: "celo", label: "Celo" },
  { id: "zksync", label: "zkSync" },
  { id: "megaeth", label: "MegaETH" },
  { id: "solana", label: "Solana" },
];

const facts = [
  { label: "Capital at risk", value: "51.6 xDAI", note: "The operator’s deposit. Returned in full if Scout accepts after 84 hours." },
  { label: "Cost to name one", value: "$0.01 USDC", note: "IPFS pin on Base via x402 — paid so explorers can read the payload." },
  { label: "When PNK vests", value: "84 hours", note: "getItemInfo / getRequestInfo. No challenge, then the pool pays the operator." },
];
---

<section class="field section" id="field">
  <div class="container">
    <p class="mono section-kicker">the beat</p>
    <h2>Twelve explorers. Four pools. One well.</h2>
    <p class="section-lede">
      The lens is the untagged field — hover it like a loupe over the chains Scout pays for. The number beside it is the operator’s take. The table is who else gets something when an item stands: explorers, wallets, projects, tooling.
    </p>

    <div class="field__stage">
      <div class="field__lens">
        <div class="field__well" id="field-well">
          <canvas id="lens" width="900" height="900"></canvas>
        </div>
        <p class="mono field__lens-cap">untagged contracts, twelve explorers</p>
      </div>

      <div class="field__earned">
        <span class="mono">operator take · if Scout accepts</span>
        <p>
          <span class="field__amount tabular" id="total-pnk">0</span>
          <span class="mono">PNK</span>
        </p>
      </div>
    </div>

    <div class="field__table" role="table">
      <div class="field__row field__row--head mono" role="row">
        <span>Registry</span>
        <span>Serves</span>
        <span>Pool / month</span>
        <span>Cap</span>
      </div>
      {registries.map((reg) => (
        <div class="field__row" role="row">
          <span>{reg.label}</span>
          <span>{reg.serves}</span>
          <span class="mono">{reg.pool}</span>
          <span class="mono">{reg.max}</span>
        </div>
      ))}
    </div>

    <ul class="field__chains">
      {chains.map((c) => (
        <li class={`chain-badge chain-badge--${c.id}`}>{c.label}</li>
      ))}
    </ul>

    <div class="field__facts">
      {facts.map((f) => (
        <article>
          <h3>{f.label}</h3>
          <p class="mono field__value">{f.value}</p>
          <p>{f.note}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { prefersReducedMotion } from "../lib/gsap/init";
  import { initMosaic } from "../lib/mosaic";

  const canvas = document.getElementById("lens") as HTMLCanvasElement | null;
  if (canvas) initMosaic(canvas);

  const well = document.getElementById("field-well");
  if (well && !prefersReducedMotion()) {
    gsap.fromTo(
      well,
      { scale: 0.84 },
      {
        scale: 1,
        ease: "none",
        scrollTrigger: {
          trigger: well,
          start: "top 85%",
          end: "center 45%",
          scrub: 0.45,
        },
      }
    );
  }
</script>

<style>
  .field__stage {
    display: grid;
    gap: 2rem;
    margin: 2.5rem 0 2.25rem;
    align-items: center;
  }

  .field__lens {
    justify-self: start;
  }

  .field__well {
    width: min(22rem, 78vw);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-field);
    box-shadow: 0 0 0 1px var(--color-border), 0 0 0 10px var(--color-bg), 0 0 0 11px var(--color-border);
    transform-origin: center;
  }

  .field__well canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .field__lens-cap {
    margin: 0.85rem 0 0;
    color: var(--color-text-muted);
  }

  .field__earned p {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0.35rem 0 0;
    color: var(--color-text);
  }

  .field__amount {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .field__table {
    border-top: 1px solid var(--color-border);
  }

  .field__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }

  .field__row--head {
    color: var(--color-text-muted);
    padding-top: 0;
    border-bottom-width: 2px;
  }

  .field__chains {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .field__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .field__facts h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .field__value {
    margin: 0 0 0.45rem;
    color: var(--color-text);
    text-transform: none;
    letter-spacing: 0;
    font-size: 1rem;
  }

  .field__facts p {
    margin: 0;
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .field__stage {
      grid-template-columns: auto 1fr;
      column-gap: 3.5rem;
    }
  }

  @media (max-width: 800px) {
    .field__row {
      grid-template-columns: 1fr 1fr;
    }

    .field__row span:nth-child(n + 3),
    .field__row--head span:nth-child(n + 3) {
      display: none;
    }

    .field__facts {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field__well {
      transform: none;
    }
  }
</style>
