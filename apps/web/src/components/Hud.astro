---
import { loadDossier } from "../lib/dossier";

const { stats } = await loadDossier();
const pnk = stats.totalPnkEarned && stats.totalPnkEarned !== "0" ? stats.totalPnkEarned : "—";
---

<aside class="hud-rail" id="hud-rail" transition:persist="hud">
  <p class="mono hud-rail__tick" id="hud-feed">awaiting the next mark on the blotter</p>
  <p class="mono hud-rail__pnk">
    operator
    <span class="tabular" id="hud-pnk">{pnk}</span>
    PNK
  </p>
</aside>

<style>
  .hud-rail {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem clamp(1.25rem, 4vw, 3.5rem) 0.7rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-text);
    color: var(--color-bg);
    box-shadow: 0 -8px 0 var(--color-bg), 0 -9px 0 var(--color-border);
  }

  .hud-rail__tick {
    margin: 0;
    color: #b7b09c;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hud-rail__pnk {
    margin: 0;
    flex-shrink: 0;
    color: #7dcea0;
  }

  .hud-rail__pnk .tabular {
    display: inline-block;
    min-width: 3ch;
    text-align: right;
  }

  #hud-feed.is-flash {
    animation: flash 0.55s var(--ease-out);
  }

  @keyframes flash {
    from { opacity: 0.35; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #hud-feed.is-flash {
      animation: none;
    }
  }
</style>
