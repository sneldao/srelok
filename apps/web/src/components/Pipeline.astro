---
/**
 * Scene 2: The Pipeline — Scroll-Driven Flow
 *
 * Shows the agent's decision process step by step.
 * Each stage reveals as you scroll, showing real-time state.
 */

const stages = [
  {
    id: "discover",
    label: "DISCOVER",
    description: "Scanning eligible chains for untagged contracts",
    detail: "Checking Base, Arbitrum, Linea, Celo...",
    icon: "🔍",
  },
  {
    id: "research",
    label: "RESEARCH",
    description: "Identifying what this contract does",
    detail: "Source code analysis, deployer lookup, project identification",
    icon: "🧠",
  },
  {
    id: "evaluate",
    label: "EVALUATE",
    description: "Policy compliance check",
    detail: "Explorer tag status: NOT TAGGED. Policy: PASS.",
    icon: "✓",
  },
  {
    id: "build",
    label: "BUILD",
    description: "Constructing item.json payload",
    detail: "MetaEvidence cross-check, CAIP-10 address format",
    icon: "⚙",
  },
  {
    id: "submit",
    label: "SUBMIT",
    description: "Upload to IPFS → addItem on-chain",
    detail: "Deposit: 51.6 xDAI (returned if accepted)",
    icon: "→",
  },
  {
    id: "track",
    label: "TRACK",
    description: "Monitor challenge window",
    detail: "84h challenge period. Respond if challenged.",
    icon: "◎",
  },
];
---

<section class="pipeline section" id="pipeline">
  <div class="container">
    <h2 class="pipeline__heading" data-reveal="heading">
      The Pipeline
    </h2>
    <p class="pipeline__intro" data-reveal="paragraph">
      Every submission passes through a six-stage process. The agent reasons at each step — no blind automation.
    </p>

    <div class="pipeline__flow">
      {stages.map((stage, i) => (
        <div class="pipeline__stage" data-reveal="element" data-stage={stage.id}>
          <div class="pipeline__stage-number mono">{String(i + 1).padStart(2, "0")}</div>
          <div class="pipeline__stage-icon">{stage.icon}</div>
          <div class="pipeline__stage-content">
            <h3 class="pipeline__stage-label mono">{stage.label}</h3>
            <p class="pipeline__stage-desc">{stage.description}</p>
            <p class="pipeline__stage-detail mono">{stage.detail}</p>
          </div>
          {i < stages.length - 1 && <div class="pipeline__connector" />}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pipeline {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pipeline__heading {
    margin-bottom: 1rem;
  }

  .pipeline__intro {
    max-width: 500px;
    margin-bottom: 4rem;
  }

  .pipeline__flow {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pipeline__stage {
    display: grid;
    grid-template-columns: 3rem 2.5rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    opacity: 0; /* revealed by GSAP */
  }

  .pipeline__stage:last-child {
    border-bottom: none;
  }

  .pipeline__stage-number {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    padding-top: 0.2rem;
  }

  .pipeline__stage-icon {
    font-size: 1.2rem;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .pipeline__stage-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pipeline__stage-label {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .pipeline__stage-desc {
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.4;
  }

  .pipeline__stage-detail {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding: 0.4rem 0.6rem;
    background: var(--color-bg);
    border-radius: 4px;
    width: fit-content;
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .pipeline__stage {
      grid-template-columns: 2rem 1fr;
    }
    .pipeline__stage-number {
      display: none;
    }
  }
</style>
