---
/**
 * Horizontal type carousel — one verb per panel, almost no copy.
 * Scroll-snap instead of a six-row essay.
 */

const stages = [
  { id: "discover", label: "Discover", hint: "untagged contracts" },
  { id: "research", label: "Research", hint: "what it is" },
  { id: "evaluate", label: "Evaluate", hint: "policy · explorer" },
  { id: "build", label: "Build", hint: "item.json" },
  { id: "submit", label: "Submit", hint: "ipfs → addItem" },
  { id: "track", label: "Track", hint: "84h window" },
];
---

<section class="pipeline" id="pipeline">
  <p class="pipeline__kicker mono">the loop</p>
  <div class="pipeline__rail" data-lenis-prevent>
    {stages.map((stage, i) => (
      <article class="pipeline__slide" data-stage={stage.id}>
        <span class="pipeline__idx mono">{String(i + 1).padStart(2, "0")}</span>
        <h2>{stage.label}</h2>
        <p class="mono">{stage.hint}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .pipeline {
    padding: 12vh 0 8vh;
    background: var(--color-bg);
  }

  .pipeline__kicker {
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
  }

  .pipeline__rail {
    display: flex;
    gap: 8vw;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 8vw;
    padding: 0 8vw 2rem;
    -webkit-overflow-scrolling: touch;
  }

  .pipeline__rail::-webkit-scrollbar {
    height: 2px;
  }

  .pipeline__rail::-webkit-scrollbar-thumb {
    background: var(--color-text);
  }

  .pipeline__slide {
    flex: 0 0 auto;
    min-width: min(78vw, 900px);
    scroll-snap-align: start;
  }

  .pipeline__slide h2 {
    font-size: clamp(4.5rem, 16vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .pipeline__idx {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-accent);
  }

  .pipeline__slide p {
    margin-top: 1.25rem;
    color: var(--color-text-muted);
  }
</style>
