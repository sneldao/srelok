---
const stages = [
  {
    id: "discover",
    label: "Discover",
    for: "Explorers",
    stamp: "find the unnamed",
    description: "Scan eligible chains for contracts that still have no explorer tag.",
    detail: "Base, Arbitrum, Optimism, Linea, Celo, and the rest of the Scout set.",
  },
  {
    id: "research",
    label: "Research",
    for: "Users",
    stamp: "no invented names",
    description: "Work out what the contract actually is before a tag is proposed.",
    detail: "Source, deployer, project name, and how it is used on-chain.",
  },
  {
    id: "evaluate",
    label: "Evaluate",
    for: "Scout",
    stamp: "protects the pool",
    description: "Check Scout policy and whether the address is already tagged.",
    detail: "Explorer status, excluded types (proxies, ERC-20/721/1155 where they do not pay), duplicate ATR hits.",
  },
  {
    id: "build",
    label: "Build",
    for: "Jurors",
    stamp: "MetaEvidence first",
    description: "Assemble a registry-specific item.json from the seed-first pattern.",
    detail: "Schema cross-check, CAIP-10 addresses, required columns only.",
  },
  {
    id: "submit",
    label: "Submit",
    for: "the TCR",
    stamp: "deposit at risk",
    description: "Pin the payload, then call addItem on the Gnosis registry.",
    detail: "IPFS via x402 ($0.01 USDC on Base). Deposit 51.6 xDAI, returned if accepted.",
  },
  {
    id: "track",
    label: "Track",
    for: "Operator",
    stamp: "PNK if it stands",
    description: "Watch the request through the challenge window and map the on-chain verdict.",
    detail: "84 hours. Challenge, acceptance, or rejection — then the pool pays.",
  },
];
---

<section class="pipeline section" id="pipeline">
  <div class="container pipeline__intro">
    <p class="mono section-kicker">six gates</p>
    <h2>Each gate protects someone</h2>
    <p class="section-lede">
      The carousel is the argument: explorers get names, Scout keeps a clean TCR, jurors get schema-true payloads, the operator only earns if the item survives. The agent can stop at any gate.
    </p>
    <div class="pipeline__controls">
      <button type="button" class="pipeline__btn mono" id="pipeline-prev" aria-label="Previous stage">prev</button>
      <span class="mono" id="pipeline-pos">01 / 06</span>
      <button type="button" class="pipeline__btn mono" id="pipeline-next" aria-label="Next stage">next</button>
    </div>
  </div>

  <div class="pipeline__rail" id="pipeline-rail" data-lenis-prevent tabindex="0">
    {stages.map((stage, i) => (
      <article class="pipeline__slide" id={stage.id} data-stage={stage.id}>
        <header class="pipeline__head">
          <span class="mono pipeline__idx">{String(i + 1).padStart(2, "0")}</span>
          <span class="mono pipeline__for">for {stage.for}</span>
        </header>
        <h3>{stage.label}</h3>
        <p class="mono pipeline__stamp">{stage.stamp}</p>
        <p>{stage.description}</p>
        <p class="mono pipeline__detail">{stage.detail}</p>
      </article>
    ))}
  </div>
</section>

<script>
  const rail = document.getElementById("pipeline-rail");
  const prev = document.getElementById("pipeline-prev");
  const next = document.getElementById("pipeline-next");
  const pos = document.getElementById("pipeline-pos");
  if (rail) {
    const slides = [...rail.querySelectorAll<HTMLElement>(".pipeline__slide")];

    function currentIndex() {
      const mid = rail!.scrollLeft + rail!.clientWidth / 2;
      let best = 0;
      let dist = Infinity;
      slides.forEach((slide, i) => {
        const c = slide.offsetLeft + slide.offsetWidth / 2;
        const d = Math.abs(c - mid);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    }

    function go(delta: number) {
      const i = Math.min(slides.length - 1, Math.max(0, currentIndex() + delta));
      slides[i].scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
    }

    function updatePos() {
      if (!pos) return;
      const i = currentIndex() + 1;
      pos.textContent = `${String(i).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
    }

    prev?.addEventListener("click", () => go(-1));
    next?.addEventListener("click", () => go(1));
    rail.addEventListener("scroll", updatePos, { passive: true });
    rail.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        go(1);
      }
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        go(-1);
      }
    });
    updatePos();
  }
</script>

<style>
  .pipeline {
    overflow: clip;
  }

  .pipeline__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .pipeline__btn {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    min-height: 40px;
    padding: 0 0.85rem;
    cursor: pointer;
  }

  .pipeline__btn:hover {
    border-color: var(--color-text);
  }

  .pipeline__rail {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(1.25rem, 4vw, 3.5rem);
    padding: 2rem clamp(1.25rem, 4vw, 3.5rem) 0.5rem;
    -webkit-overflow-scrolling: touch;
    outline: none;
  }

  .pipeline__rail::-webkit-scrollbar {
    height: 2px;
  }

  .pipeline__rail::-webkit-scrollbar-thumb {
    background: var(--color-text);
  }

  .pipeline__slide {
    flex: 0 0 auto;
    width: min(78vw, 34rem);
    scroll-snap-align: center;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 2rem 1.75rem 1.85rem;
    min-height: 24rem;
  }

  .pipeline__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .pipeline__idx {
    color: #7dcea0;
  }

  .pipeline__for {
    color: #7dcea0;
    letter-spacing: 0.08em;
  }

  .pipeline__slide h3 {
    margin: 1.1rem 0 0.35rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    color: var(--color-bg);
    line-height: 0.95;
  }

  .pipeline__stamp {
    margin: 0 0 0.85rem;
    color: #7dcea0;
    letter-spacing: 0.06em;
  }

  .pipeline__slide p {
    margin: 0;
    max-width: 28rem;
    color: #d4cdb8;
  }

  .pipeline__detail {
    margin-top: 1rem;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.78rem;
    color: #b7b09c;
  }
</style>
