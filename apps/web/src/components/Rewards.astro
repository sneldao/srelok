---
/**
 * One number. The rest is noise.
 */
---

<section class="rewards" id="rewards">
  <span class="mono">earned</span>
  <div class="rewards__total">
    <span class="rewards__amount tabular" data-reveal="counter" data-target="0" id="total-pnk">0</span>
    <span class="rewards__unit">PNK</span>
  </div>
</section>

<style>
  .rewards {
    padding: 12vh clamp(1.25rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rewards .mono {
    color: var(--color-text-muted);
  }

  .rewards__total {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .rewards__amount {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 18vw, 12rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .rewards__unit {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }
</style>
