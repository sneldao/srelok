{
  "name": "@kleros-scout/pipeline",
  "version": "0.1.0",
  "description": "On-chain submission pipeline — discover, validate, build, upload, submit",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./submit/*": "./src/submit/*.ts",
    "./candidates/*": "./src/candidates/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "discover": "tsx src/candidates/discover.ts",
    "validate": "tsx src/submit/validate.ts",
    "submit": "tsx src/submit/index.ts",
    "challenge": "tsx src/challenge/index.ts",
    "status": "tsx scripts/status.ts",
    "check-explorer": "tsx scripts/check-explorer.ts",
    "test-registry": "tsx scripts/test-registry.ts"
  },
  "dependencies": {
    "viem": "2.21.19",
    "dotenv": "16.4.7",
    "x402-fetch": "1.2.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "@types/node": "22.9.0"
  }
}
